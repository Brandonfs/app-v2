NODE_ENV=development
PORT=4000
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=8h
QR_SECRET=replace-with-qr-secret
BOOTSTRAP_ADMIN_TOKEN=replace-with-one-time-bootstrap-token
LATE_AFTER=09:05
APP_TIMEZONE=America/Bogota
ATTENDANCE_COOLDOWN_MINUTES=10
DB_CLIENT=sqlite3
DB_FILENAME=./backend/data/app.db
